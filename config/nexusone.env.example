# Copy to ~/.config/nexusone/env and chmod 600.
NEXUSONE_ENV=production
NEXUSONE_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_bytes
NEXUSONE_PORT=7171
NEXUSONE_ALLOW_LAN=0
NEXUSONE_COOKIE_SECURE=1

NEXUSONE_ODYSSEUS_COMPOSE_FILE=~/Projects/odysseus/docker-compose.yml
NEXUSONE_AUDIT_FILE=~/.local/state/nexusone/audit.sqlite3
